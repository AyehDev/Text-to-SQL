@@ -0,0 +1,122 @@
+"""Decide whether a generated query returned the same answer as the gold query (SPEC 5.18).
+
+Results are compared, not SQL text, because many different queries answer the same
+question. Two results match when they hold the same rows, with these allowances:
+
+  - column names and aliases are ignored, and so is column order, as long as some
+    pairing of the columns makes the rows equal;
+  - row order is ignored unless the question asks for an ordering (`order_matters`);
+  - numbers compare by value: "8248.9900", "8248.99" and "8.24899e3" are equal, and
+    floating-point noise past 9 significant digits is ignored;
+  - surrounding whitespace in text is ignored; NULL equals NULL and nothing else.
+
+Not allowed: different row counts, duplicates collapsing (rows are compared as a
+multiset), or different rounding (ROUND(x, 2) does not equal x).
+
+A truncated result is never a match, because the rows that were cut off are unknown.
+Run gold queries with a row limit large enough that they are not truncated.
+"""
+
+from __future__ import annotations
+
+from collections import Counter
+from decimal import Context, Decimal, InvalidOperation
+
+from schemagraph.models import QueryResult
+
+SIGNIFICANT_DIGITS = 9
+MAX_COLUMN_PAIRINGS = 1000  # cap on the column permutations tried for one pair of results
+
+_CONTEXT = Context(prec=SIGNIFICANT_DIGITS)
+
+Cell = tuple[str, str] | None  # (kind, value); None is SQL NULL
+Row = tuple[Cell, ...]
+
+
+def normalize_value(value: str | None) -> Cell:
+    """Make one cell comparable. Numbers become a canonical string, text is stripped."""
+    if value is None:
+        return None
+    text = value.strip()
+    try:
+        number = Decimal(text)
+    except InvalidOperation:
+        return ("s", text)
+    if not number.is_finite():  # 'NaN' and 'Infinity' are words here, not numbers
+        return ("s", text)
+    number = _CONTEXT.plus(number)  # round to SIGNIFICANT_DIGITS
+    if number == 0:
+        return ("n", "0")  # also folds -0
+    return ("n", format(number.normalize(), "f"))
+
+
+def _sort_key(cell: Cell) -> tuple[int, str, str]:
+    return (0, "", "") if cell is None else (1, cell[0], cell[1])
+
+
+def _columns(rows: list[Row], width: int) -> list[Counter]:
+    return [Counter(row[i] for row in rows) for i in range(width)]
+
+
+def _signature(column: Counter) -> tuple:
+    return tuple(sorted(column.items(), key=lambda kv: (_sort_key(kv[0]), kv[1])))
+
+
+def _pairings(gold_sigs: list[tuple], pred_sigs: list[tuple]):
+    """Ways to line predicted columns up with gold columns: each gold column takes a
+    predicted column holding exactly the same multiset of values."""
+    n = len(gold_sigs)
+    used = [False] * n
+
+    def extend(i: int, chosen: list[int]):
+        if i == n:
+            yield list(chosen)
+            return
+        for j in range(n):
+            if not used[j] and pred_sigs[j] == gold_sigs[i]:
+                used[j] = True
+                chosen.append(j)
+                yield from extend(i + 1, chosen)
+                chosen.pop()
+                used[j] = False
+
+    return extend(0, [])
+
+
+def results_match(gold: QueryResult, predicted: QueryResult, order_matters: bool = False) -> bool:
+    """True if `predicted` returned the same answer as `gold` (see the module docstring)."""
+    if gold.truncated or predicted.truncated:
+        return False
+    if len(gold.columns) != len(predicted.columns):
+        return False
+
+    width = len(gold.columns)
+    gold_rows = [tuple(normalize_value(v) for v in row) for row in gold.rows]
+    pred_rows = [tuple(normalize_value(v) for v in row) for row in predicted.rows]
+    if len(gold_rows) != len(pred_rows):
+        return False
+    if not gold_rows or width == 0:
+        return True  # same shape, both empty
+
+    # Cheap exact test first: same columns in the same order.
+    if _same(gold_rows, pred_rows, order_matters):
+        return True
+
+    gold_sigs = [_signature(c) for c in _columns(gold_rows, width)]
+    pred_sigs = [_signature(c) for c in _columns(pred_rows, width)]
+    if Counter(gold_sigs) != Counter(pred_sigs):
+        return False  # no column pairing can work
+
+    for tried, order in enumerate(_pairings(gold_sigs, pred_sigs)):
+        if tried >= MAX_COLUMN_PAIRINGS:
+            return False
+        permuted = [tuple(row[j] for j in order) for row in pred_rows]
+        if _same(gold_rows, permuted, order_matters):
+            return True
+    return False
+
+
+def _same(gold_rows: list[Row], pred_rows: list[Row], order_matters: bool) -> bool:
+    if order_matters:
+        return gold_rows == pred_rows
+    return Counter(gold_rows) == Counter(pred_rows)
diff --git a/schemagraph/eval/run_eval.py b/schemagraph/eval/run_eval.py
new file mode 100644
index 0000000..ef4b6f6
--- /dev/null
+++ b/schemagraph/eval/run_eval.py
@@ -0,0 +1,420 @@
+"""Run the evaluation questions through the pipeline and score the answers (SPEC 5.20).
+
+For every question and every mode this asks `answer_question` for SQL, runs the
+gold SQL once, and compares the two results (compare.py). It also records which
+tables each mode gave the model (schema_metrics.py). One JSONL row per question per
+mode is appended to the output file, and the file is written as the run goes, so an
+interrupted run can be resumed with the same --run-id: finished rows are skipped.
+
+    python -m schemagraph.eval.run_eval --questions schemagraph/eval/questions/adventureworks.jsonl \\
+        --modes full retrieval graph --out results/2026-11-12-a.jsonl --run-id 2026-11-12-a \\
+        --llm-model <model>
+
+    python -m schemagraph.eval.run_eval --questions ... --check-gold     # validate gold SQL only
+    python -m schemagraph.eval.run_eval --summarize results/2026-11-12-a.jsonl
+
+Gold SQL is checked before anything is sent to the model, so a broken question costs
+nothing. The model is never asked to explain (`explain=False`).
+"""
+
+from __future__ import annotations
+
+import argparse
+import logging
+import sys
+from collections import defaultdict
+from collections.abc import Callable
+from dataclasses import dataclass, field
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, get_args
+
+from pydantic import ValidationError
+
+from schemagraph.eval.compare import results_match
+from schemagraph.eval.schema_metrics import bridge_tables_needed, schema_recall, tables_in_sql
+from schemagraph.models import (
+    AskOptions,
+    AskRequest,
+    AskResponse,
+    EvalResult,
+    Mode,
+    QueryResult,
+    Question,
+    display_name,
+)
+
+log = logging.getLogger(__name__)
+
+GOLD_ROW_LIMIT = 100_000  # large enough that neither the gold nor the generated result is truncated
+
+AnswerFn = Callable[..., AskResponse]
+QueryFn = Callable[[str, str, int], QueryResult]
+
+
+# ---------------------------------------------------------------------------
+# Questions
+# ---------------------------------------------------------------------------
+
+
+def load_questions(path: Path, split: str = "test") -> list[Question]:
+    """Read a JSONL question file and keep one split ('test', 'dev', or 'all').
+
+    Blank lines are skipped. A bad line raises ValueError naming the file and line.
+    """
+    if split not in ("test", "dev", "all"):
+        raise ValueError(f"split must be 'test', 'dev' or 'all', got {split!r}")
+    questions: list[Question] = []
+    for number, line in enumerate(Path(path).read_text(encoding="utf-8").splitlines(), start=1):
+        if not line.strip():
+            continue
+        try:
+            question = Question.model_validate_json(line)
+        except ValidationError as exc:
+            raise ValueError(f"{path}:{number}: {exc}") from exc
+        if split == "all" or question.split == split:
+            questions.append(question)
+    return questions
+
+
+def load_question_files(paths: list[Path], split: str = "test") -> list[Question]:
+    """Questions from several files, in order. Ids must be unique across all of them."""
+    questions = [q for path in paths for q in load_questions(path, split)]
+    seen: set[str] = set()
+    for q in questions:
+        if q.id in seen:
+            raise ValueError(f"duplicate question id {q.id!r}")
+        seen.add(q.id)
+    return questions
+
+
+# ---------------------------------------------------------------------------
+# Gold SQL
+# ---------------------------------------------------------------------------
+
+
+@dataclass
+class GoldCheck:
+    results: dict[str, QueryResult] = field(default_factory=dict)  # question id -> result
+    errors: dict[str, str] = field(default_factory=dict)           # question id -> why it cannot be used
+    empty: list[str] = field(default_factory=list)                 # ids whose gold returns no rows (weak tests)
+
+
+def _default_query(db_id: str, sql: str, row_limit: int) -> QueryResult:
+    from schemagraph.db import postgres  # imported here so the module loads without a database
+
+    return postgres.run_readonly_query(db_id, sql, row_limit)
+
+
+def check_gold(questions: list[Question], run_query: QueryFn | None = None) -> GoldCheck:
+    """Run every gold query once. A query that fails, or returns too many rows to compare, is an error."""
+    run_query = run_query or _default_query
+    check = GoldCheck()
+    for q in questions:
+        try:
+            result = run_query(q.db_id, q.gold_sql, GOLD_ROW_LIMIT)
+        except Exception as exc:  # noqa: BLE001 - any failure makes the question unusable
+            check.errors[q.id] = f"gold SQL failed: {exc}"
+            continue
+        if result.truncated:
+            check.errors[q.id] = f"gold SQL returns more than {GOLD_ROW_LIMIT} rows"
+            continue
+        check.results[q.id] = result
+        if result.row_count == 0:
+            check.empty.append(q.id)
+    return check
+
+
+# ---------------------------------------------------------------------------
+# Scoring (pure)
+# ---------------------------------------------------------------------------
+
+
+def context_tables(response: AskResponse) -> list[str]:
+    """Display names of the tables the model was given. The join plan wins; otherwise the explanation's list."""
+    if response.join_plan is not None and response.join_plan.tables:
+        return sorted(display_name(uid) for uid in response.join_plan.tables)
+    if response.explanation is not None:
+        return sorted(display_name(t.uid) for t in response.explanation.tables)
+    return []
+
+
+def seed_tables(response: AskResponse) -> set[str] | None:
+    """Tables retrieval returned, or None when this response does not say.
+
+    Graph mode has them in the join plan. Retrieval mode's context is its seeds.
+    Full mode has no seeds, so its bridge metrics are left empty.
+    """
+    if response.join_plan is not None and response.join_plan.seed_tables:
+        return {display_name(s.uid) for s in response.join_plan.seed_tables}
+    if response.explanation is not None:
+        seeds = {display_name(t.uid) for t in response.explanation.tables if t.role == "seed"}
+        if seeds:
+            return seeds
+    if response.mode == "retrieval":
+        return set(context_tables(response))
+    return None
+
+
+def score(
+    question: Question,
+    response: AskResponse,
+    gold: QueryResult,
+    *,
+    run_id: str,
+    llm_model: str,
+    timestamp: datetime,
+) -> EvalResult:
+    """Turn one pipeline response into one result row."""
+    gold_tables = tables_in_sql(question.gold_sql)
+    context = set(context_tables(response))
+    seeds = seed_tables(response)
+    needed = bridge_tables_needed(gold_tables, seeds) if seeds is not None else set()
+    correct = (
+        response.status == "success"
+        and response.result is not None
+        and results_match(gold, response.result, question.order_matters)
+    )
+    return EvalResult(
+        question_id=question.id,
+        db_id=question.db_id,
+        mode=response.mode,
+        tier=question.tier,
+        correct=correct,
+        status=response.status,
+        generated_sql=response.sql,
+        gold_tables=sorted(gold_tables),
+        context_tables=sorted(context),
+        schema_recall=schema_recall(gold_tables, context),
+        bridge_tables_needed=sorted(needed),
+        bridge_tables_recovered=sorted(needed & context),
+        plan_status=response.join_plan.status if response.join_plan is not None else None,
+        input_tokens=response.metrics.input_tokens,
+        latency_ms=response.metrics.latency_ms.total,
+        attempt_count=response.metrics.attempt_count,
+        llm_model=llm_model,
+        run_id=run_id,
+        timestamp=timestamp,
+    )
+
+
+# ---------------------------------------------------------------------------
+# Running
+# ---------------------------------------------------------------------------
+
+
+@dataclass
+class RunReport:
+    run_id: str
+    written: int = 0
+    already_done: int = 0
+    skipped_bad_gold: dict[str, str] = field(default_factory=dict)
+    errors: list[tuple[str, str, str]] = field(default_factory=list)  # (question id, mode, message)
+
+
+class GoldError(RuntimeError):
+    """Some gold queries cannot be used and --skip-bad-gold was not given."""
+
+
+def _default_answer() -> AnswerFn:
+    try:
+        from schemagraph.pipeline.pipeline import answer_question
+    except ImportError as exc:
+        raise RuntimeError("schemagraph.pipeline.pipeline.answer_question is not available yet") from exc
+    return answer_question
+
+
+def load_results(path: Path, run_id: str | None = None) -> list[EvalResult]:
+    results = []
+    for line in Path(path).read_text(encoding="utf-8").splitlines():
+        if line.strip():
+            row = EvalResult.model_validate_json(line)
+            if run_id is None or row.run_id == run_id:
+                results.append(row)
+    return results
+
+
+def run_eval(
+    question_files: list[Path],
+    modes: list[Mode],
+    out_path: Path,
+    run_id: str,
+    planner_options: dict[str, Any] | None = None,
+    *,
+    llm_model: str = "unspecified",
+    split: str = "test",
+    use_evidence: bool = True,
+    skip_bad_gold: bool = False,
+    answer: AnswerFn | None = None,
+    run_query: QueryFn | None = None,
+    now: Callable[[], datetime] | None = None,
+) -> RunReport:
+    """Score every question in every mode and append the rows to `out_path`.
+
+    planner_options (for the ablations, e.g. {"include_inferred": False, "weighted": False})
+    is passed to `answer_question` as the keyword `planner_options` when it is not empty;
+    the pipeline must accept it. With use_evidence, a BIRD question's hint is appended to
+    the question text. Raises GoldError, before any model call, if a gold query is
+    unusable and skip_bad_gold is False.
+    """
+    for mode in modes:
+        if mode not in get_args(Mode):
+            raise ValueError(f"unknown mode {mode!r}; expected one of {get_args(Mode)}")
+    now = now or (lambda: datetime.now(timezone.utc))
+    questions = load_question_files(question_files, split)
+    report = RunReport(run_id=run_id)
+
+    gold = check_gold(questions, run_query)
+    if gold.errors:
+        if not skip_bad_gold:
+            lines = "\n".join(f"  {qid}: {why}" for qid, why in gold.errors.items())
+            raise GoldError(f"{len(gold.errors)} gold queries cannot be used:\n{lines}")
+        report.skipped_bad_gold = dict(gold.errors)
+    questions = [q for q in questions if q.id in gold.results]
+
+    out_path = Path(out_path)
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    done = {(r.question_id, r.mode) for r in load_results(out_path, run_id)} if out_path.exists() else set()
+    answer = answer or _default_answer()
+
+    with out_path.open("a", encoding="utf-8") as out:
+        for q in questions:
+            text = f"{q.question}\nHint: {q.evidence}" if use_evidence and q.evidence else q.question
+            for mode in modes:
+                if (q.id, mode) in done:
+                    report.already_done += 1
+                    continue
+                request = AskRequest(
+                    question=text, db_id=q.db_id, mode=mode, options=AskOptions(row_limit=GOLD_ROW_LIMIT)
+                )
+                try:
+                    kwargs = {"planner_options": planner_options} if planner_options else {}
+                    response = answer(request, explain=False, **kwargs)
+                    row = score(q, response, gold.results[q.id], run_id=run_id, llm_model=llm_model, timestamp=now())
+                except Exception as exc:  # noqa: BLE001 - one bad call must not end a long run
+                    log.error("%s [%s] failed: %s", q.id, mode, exc)
+                    report.errors.append((q.id, mode, str(exc)))
+                    continue  # not written, so a resumed run tries it again
+                out.write(row.model_dump_json(by_alias=True) + "\n")
+                out.flush()
+                report.written += 1
+    return report
+
+
+# ---------------------------------------------------------------------------
+# Summary
+# ---------------------------------------------------------------------------
+
+
+def aggregate(results: list[EvalResult]) -> list[dict[str, Any]]:
+    """One row per mode and tier, plus an 'all' row per mode. Pure, so it needs no pandas."""
+    groups: dict[tuple[str, str], list[EvalResult]] = defaultdict(list)
+    for r in results:
+        groups[(r.mode, str(r.tier))].append(r)
+        groups[(r.mode, "all")].append(r)
+
+    def mean(values: list[float]) -> float:
+        return sum(values) / len(values)
+
+    rows = []
+    for (mode, tier), rs in sorted(groups.items()):
+        needed = sum(len(r.bridge_tables_needed) for r in rs)
+        recovered = sum(len(r.bridge_tables_recovered) for r in rs)
+        rows.append(
+            {
+                "mode": mode,
+                "tier": tier,
+                "n": len(rs),
+                "accuracy": mean([r.correct for r in rs]),
+                "schema_recall": mean([r.schema_recall for r in rs]),
+                "bridge_needed": needed,
+                "bridge_recovery": recovered / needed if needed else None,
+                "attempts": mean([r.attempt_count for r in rs]),
+                "input_tokens": mean([r.input_tokens for r in rs]),
+                "latency_ms": mean([r.latency_ms for r in rs]),
+            }
+        )
+    return rows
+
+
+def summarize(results_path: Path, run_id: str | None = None):
+    """Accuracy and context metrics by mode and tier, as a pandas DataFrame (needs the `eval` extra)."""
+    import pandas as pd
+
+    return pd.DataFrame(aggregate(load_results(results_path, run_id)))
+
+
+def format_summary(rows: list[dict[str, Any]]) -> str:
+    header = f"{'mode':<10}{'tier':<6}{'n':>5}{'accuracy':>10}{'recall':>8}{'bridges':>9}{'recovered':>11}{'tries':>7}{'tokens':>9}{'ms':>8}"
+    lines = [header]
+    for r in rows:
+        recovery = "-" if r["bridge_recovery"] is None else f"{r['bridge_recovery']:.0%}"
+        lines.append(
+            f"{r['mode']:<10}{r['tier']:<6}{r['n']:>5}{r['accuracy']:>10.0%}{r['schema_recall']:>8.0%}"
+            f"{r['bridge_needed']:>9}{recovery:>11}{r['attempts']:>7.1f}{r['input_tokens']:>9.0f}{r['latency_ms']:>8.0f}"
+        )
+    return "\n".join(lines)
+
+
+# ---------------------------------------------------------------------------
+# Command line
+# ---------------------------------------------------------------------------
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Run the evaluation questions and score them.")
+    parser.add_argument("--questions", nargs="+", type=Path, help="question JSONL file(s)")
+    parser.add_argument("--modes", nargs="+", default=list(get_args(Mode)), choices=list(get_args(Mode)))
+    parser.add_argument("--out", type=Path, help="results JSONL (appended to; resumable with the same --run-id)")
+    parser.add_argument("--run-id", default=datetime.now(timezone.utc).strftime("%Y-%m-%d-%H%M"))
+    parser.add_argument("--llm-model", default="unspecified", help="recorded in every row")
+    parser.add_argument("--split", default="test", choices=["test", "dev", "all"])
+    parser.add_argument("--skip-bad-gold", action="store_true", help="drop questions whose gold SQL fails")
+    parser.add_argument("--no-evidence", action="store_true", help="do not append BIRD hints to the question")
+    parser.add_argument("--no-inferred", action="store_true", help="ablation: planner ignores inferred edges")
+    parser.add_argument("--unweighted", action="store_true", help="ablation: planner treats every edge as cost 1")
+    parser.add_argument("--check-gold", action="store_true", help="only run the gold SQL and report problems")
+    parser.add_argument("--summarize", type=Path, help="print the summary of a results file and exit")
+    args = parser.parse_args(argv)
+    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
+
+    if args.summarize:
+        print(format_summary(aggregate(load_results(args.summarize))))
+        return 0
+    if not args.questions:
+        parser.error("--questions is required")
+
+    if args.check_gold:
+        questions = load_question_files(args.questions, args.split)
+        check = check_gold(questions)
+        print(f"{len(check.results)} of {len(questions)} gold queries usable")
+        for qid, why in check.errors.items():
+            print(f"  ERROR {qid}: {why}")
+        for qid in check.empty:
+            print(f"  WARN  {qid}: gold returns no rows, so it barely tests anything")
+        return 1 if check.errors else 0
+
+    if not args.out:
+        parser.error("--out is required")
+    options: dict[str, Any] = {}
+    if args.no_inferred:
+        options["include_inferred"] = False
+    if args.unweighted:
+        options["weighted"] = False
+    try:
+        report = run_eval(
+            args.questions, args.modes, args.out, args.run_id, options or None,
+            llm_model=args.llm_model, split=args.split, use_evidence=not args.no_evidence,
+            skip_bad_gold=args.skip_bad_gold,
+        )
+    except GoldError as exc:
+        print(exc, file=sys.stderr)
+        return 1
+    print(f"run {report.run_id}: wrote {report.written}, already done {report.already_done}, "
+          f"bad gold {len(report.skipped_bad_gold)}, errors {len(report.errors)}")
+    print(format_summary(aggregate(load_results(args.out, args.run_id))))
+    return 1 if report.errors else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/schemagraph/eval/schema_metrics.py b/schemagraph/eval/schema_metrics.py
new file mode 100644
index 0000000..2ee7faa
--- /dev/null
+++ b/schemagraph/eval/schema_metrics.py
@@ -0,0 +1,36 @@
+"""How much of the right schema did a mode put in front of the model (SPEC 5.19)?
+
+All three functions work on display names, 'schema.table', which is also what the
+evaluation result file stores. Convert UIDs with `models.display_name`.
+"""
+
+from __future__ import annotations
+
+from schemagraph.sql_validation import referenced_tables
+
+
+def tables_in_sql(sql: str, default_schema: str = "public") -> set[str]:
+    """Tables a query reads, as 'schema.table'. Unqualified names get `default_schema`.
+
+    PostgreSQL resolves an unqualified name through the search path, which is
+    `public` unless configured otherwise, so that is the default here (BIRD
+    databases live in `public`; AdventureWorks queries are schema-qualified).
+    Tables defined by WITH are not counted, and unparsable SQL gives an empty set.
+    """
+    return {name if "." in name else f"{default_schema}.{name}" for name in referenced_tables(sql)}
+
+
+def schema_recall(gold_tables: set[str], context_tables: set[str]) -> float:
+    """Share of the tables the gold query needs that were in the context (1.0 if it needs none)."""
+    if not gold_tables:
+        return 1.0
+    return len(gold_tables & context_tables) / len(gold_tables)
+
+
+def bridge_tables_needed(gold_tables: set[str], seed_tables: set[str]) -> set[str]:
+    """Gold tables that retrieval did not return, so something else had to supply them.
+
+    In graph mode these are the tables the join planner had to add; in retrieval
+    mode nothing adds them, so a model in that mode cannot recover them.
+    """
+    return gold_tables - seed_tables
diff --git a/tests/test_eval_compare.py b/tests/test_eval_compare.py
new file mode 100644
index 0000000..5331c05
--- /dev/null
+++ b/tests/test_eval_compare.py
@@ -0,0 +1,141 @@
+import pytest
+
+from schemagraph.eval.compare import MAX_COLUMN_PAIRINGS, normalize_value, results_match
+from schemagraph.models import QueryResult
+
+
+def qr(cols, rows, truncated=False):
+    return QueryResult(columns=cols, rows=rows, row_count=len(rows), truncated=truncated)
+
+
+# ----------------------------------------------------------------- normalize_value
+
+
+@pytest.mark.parametrize(
+    "a,b",
+    [
+        ("8248.99", "8248.9900"),
+        ("1", "1.0"),
+        ("1", "1.000000"),
+        ("0", "-0.0"),
+        ("1e3", "1000"),
+        ("  42 ", "42"),
+        ("0.1000000001", "0.1"),            # noise beyond 9 significant digits
+        ("123456789.4", "123456789"),
+    ],
+)
+def test_equal_numbers_normalize_alike(a, b):
+    assert normalize_value(a) == normalize_value(b)
+
+
+@pytest.mark.parametrize(
+    "a,b",
+    [("8248.99", "8248.98"), ("1", "10"), ("0.5", "0.51"), ("abc", "ABC"), ("NaN", "0"), ("1", None), ("", None)],
+)
+def test_different_values_stay_different(a, b):
+    assert normalize_value(a) != normalize_value(b)
+
+
+def test_null_and_text():
+    assert normalize_value(None) is None
+    assert normalize_value(" Jon ") == normalize_value("Jon")
+    assert normalize_value("Infinity") == ("s", "Infinity")   # a word, not a number
+    assert normalize_value("007") == normalize_value("7")     # numeric strings compare as numbers
+
+
+# ----------------------------------------------------------------- results_match
+
+
+def test_identical_results_match():
+    r = qr(["a", "b"], [["1", "x"], ["2", "y"]])
+    assert results_match(r, r, order_matters=False)
+    assert results_match(r, r, order_matters=True)
+
+
+def test_column_names_are_ignored():
+    assert results_match(qr(["total"], [["5"]]), qr(["sum"], [["5"]]))
+
+
+def test_row_order_ignored_unless_it_matters():
+    gold = qr(["a"], [["1"], ["2"], ["3"]])
+    shuffled = qr(["a"], [["3"], ["1"], ["2"]])
+    assert results_match(gold, shuffled, order_matters=False)
+    assert not results_match(gold, shuffled, order_matters=True)
+    assert results_match(gold, gold, order_matters=True)
+
+
+def test_duplicate_rows_are_counted():
+    assert not results_match(qr(["a"], [["1"], ["1"], ["2"]]), qr(["a"], [["1"], ["2"], ["2"]]))
+    assert not results_match(qr(["a"], [["1"], ["1"]]), qr(["a"], [["1"]]))
+
+
+def test_numbers_and_nulls():
+    gold = qr(["n", "t"], [["8248.99", None], ["1", "x"]])
+    assert results_match(gold, qr(["n", "t"], [["1.00", "x"], ["8248.9900", None]]))
+    assert not results_match(qr(["a"], [[None]]), qr(["a"], [[""]]))   # NULL is not the empty string
+    assert not results_match(qr(["a"], [["8248.99"]]), qr(["a"], [["8248.98"]]))
+    assert not results_match(qr(["a"], [["8248.99"]]), qr(["a"], [["8249"]]))  # different rounding
+
+
+def test_text_is_case_sensitive():
+    assert not results_match(qr(["a"], [["Jon"]]), qr(["a"], [["jon"]]))
+
+
+# ----------------------------------------------------------------- column order
+
+
+def test_swapped_columns_match():
+    gold = qr(["firstname", "total"], [["Jon", "5"], ["Eugene", "7"]])
+    pred = qr(["t", "n"], [["7", "Eugene"], ["5", "Jon"]])
+    assert results_match(gold, pred)
+
+
+def test_swapped_columns_with_row_order():
+    gold = qr(["a", "b"], [["x", "1"], ["y", "2"]])
+    pred = qr(["b", "a"], [["1", "x"], ["2", "y"]])
+    assert results_match(gold, pred, order_matters=True)
+    assert not results_match(gold, qr(["b", "a"], [["2", "y"], ["1", "x"]]), order_matters=True)
+
+
+def test_columns_cannot_be_recombined_across_rows():
+    # the same values per column, but the rows pair them differently
+    gold = qr(["a", "b"], [["1", "x"], ["2", "y"]])
+    pred = qr(["a", "b"], [["1", "y"], ["2", "x"]])
+    assert not results_match(gold, pred)
+
+
+def test_identical_columns_still_resolve():
+    gold = qr(["a", "b", "c"], [["1", "1", "p"], ["2", "2", "q"]])
+    assert results_match(gold, qr(["c", "a", "b"], [["p", "1", "1"], ["q", "2", "2"]]))
+
+
+def test_pairing_search_is_capped():
+    # 7 identical columns have 5040 pairings; a wrong answer must stop at the cap, not spin
+    n = 7
+    gold = qr([f"c{i}" for i in range(n)], [["1"] * n, ["2"] * n])
+    pred = qr([f"c{i}" for i in range(n)], [["1"] * n, ["3"] * n])
+    assert not results_match(gold, pred)
+    assert MAX_COLUMN_PAIRINGS < 5040
+    assert results_match(gold, gold)   # the cheap exact test succeeds first
+
+
+# ----------------------------------------------------------------- shape
+
+
+def test_different_column_or_row_counts_do_not_match():
+    assert not results_match(qr(["a"], [["1"]]), qr(["a", "b"], [["1", "2"]]))
+    assert not results_match(qr(["a"], [["1"], ["2"]]), qr(["a"], [["1"]]))
+
+
+def test_empty_results():
+    assert results_match(qr(["a"], []), qr(["b"], []))
+    assert not results_match(qr(["a"], []), qr(["a", "b"], []))   # same emptiness, different shape
+    assert not results_match(qr(["a"], []), qr(["a"], [["1"]]))
+
+
+def test_truncated_results_never_match():
+    full = qr(["a"], [["1"]])
+    cut = qr(["a"], [["1"]], truncated=True)
+    assert not results_match(full, cut)
+    assert not results_match(cut, full)
+    assert not results_match(cut, cut)
diff --git a/tests/test_eval_run.py b/tests/test_eval_run.py
new file mode 100644
index 0000000..6663482
--- /dev/null
+++ b/tests/test_eval_run.py
@@ -0,0 +1,350 @@
+"""run_eval with a fake pipeline and fake gold queries: no database, no model."""
+
+import json
+from datetime import datetime, timezone
+
+import pytest
+
+from schemagraph.eval import run_eval as ev
+from schemagraph.models import (
+    AskResponse,
+    Explanation,
+    ExplainTable,
+    JoinPlan,
+    LatencyMs,
+    Metrics,
+    QueryResult,
+    SeedTable,
+)
+
+DB = "adventureworks"
+HEADER, CUSTOMER, PERSON = (f"{DB}:sales.salesorderheader", f"{DB}:sales.customer", f"{DB}:person.person")
+GOLD_SQL = (
+    "SELECT p.firstname, SUM(h.totaldue) FROM sales.salesorderheader h "
+    "JOIN sales.customer c ON h.customerid = c.customerid "
+    "JOIN person.person p ON c.personid = p.businessentityid GROUP BY p.firstname"
+)
+NOW = datetime(2026, 11, 12, 19, 0, tzinfo=timezone.utc)
+
+
+def qr(cols, rows, truncated=False):
+    return QueryResult(columns=cols, rows=rows, row_count=len(rows), truncated=truncated)
+
+
+GOLD = qr(["firstname", "total"], [["Jon", "8248.99"], ["Eugene", "6383.66"]])
+
+
+def question(**over):
+    row = {"id": "aw-001", "db_id": DB, "question": "total per person", "gold_sql": GOLD_SQL, "tier": 3,
+           "split": "test", "order_matters": False, "evidence": None, "author": "t", "notes": ""}
+    row.update(over)
+    return row
+
+
+def write_questions(path, rows):
+    path.write_text("\n".join(json.dumps(r) for r in rows) + "\n")
+    return path
+
+
+def graph_response(mode="graph", result=GOLD, status="success", tables=(HEADER, CUSTOMER, PERSON),
+                   seeds=(HEADER, PERSON), plan_status="full", attempts=1, tokens=1800):
+    plan = JoinPlan(
+        db_id=DB, status=plan_status, algorithm="shortest_path",
+        seed_tables=[SeedTable(uid=u, score=0.8, matched_on="table") for u in seeds],
+        bridge_tables=[t for t in tables if t not in seeds], tables=list(tables),
+    )
+    return AskResponse(
+        request_id="r", question="q", db_id=DB, mode=mode, status=status, sql="SELECT ...", result=result,
+        join_plan=plan if mode == "graph" else None,
+        metrics=Metrics(input_tokens=tokens, attempt_count=attempts, latency_ms=LatencyMs(total=900)),
+    )
+
+
+def run(tmp_path, answer, rows=None, modes=("graph",), **kw):
+    qfile = write_questions(tmp_path / "q.jsonl", rows or [question()])
+    out = tmp_path / "out" / "r.jsonl"
+    report = ev.run_eval(
+        [qfile], list(modes), out, "run-a", llm_model="m", answer=answer,
+        run_query=kw.pop("run_query", lambda db, sql, n: GOLD), now=lambda: NOW, **kw,
+    )
+    return report, out
+
+
+def read(out):
+    return [json.loads(line) for line in out.read_text().splitlines()]
+
+
+# ----------------------------------------------------------------- loading
+
+
+def test_load_questions_filters_split_and_skips_blank_lines(tmp_path):
+    path = tmp_path / "q.jsonl"
+    path.write_text(json.dumps(question()) + "\n\n" + json.dumps(question(id="aw-002", split="dev")) + "\n")
+    assert [q.id for q in ev.load_questions(path)] == ["aw-001"]
+    assert [q.id for q in ev.load_questions(path, "dev")] == ["aw-002"]
+    assert [q.id for q in ev.load_questions(path, "all")] == ["aw-001", "aw-002"]
+    with pytest.raises(ValueError, match="split"):
+        ev.load_questions(path, "train")
+
+
+def test_load_questions_names_the_bad_line(tmp_path):
+    path = tmp_path / "q.jsonl"
+    path.write_text(json.dumps(question()) + "\n" + json.dumps(question(tier=7)) + "\n")
+    with pytest.raises(ValueError, match=r"q\.jsonl:2"):
+        ev.load_questions(path)
+
+
+def test_duplicate_ids_across_files_are_rejected(tmp_path):
+    a = write_questions(tmp_path / "a.jsonl", [question()])
+    b = write_questions(tmp_path / "b.jsonl", [question()])
+    with pytest.raises(ValueError, match="duplicate"):
+        ev.load_question_files([a, b])
+
+
+# ----------------------------------------------------------------- gold
+
+
+def test_check_gold_reports_errors_truncation_and_empty(tmp_path):
+    qs = ev.load_questions(write_questions(tmp_path / "q.jsonl", [
+        question(id="ok"), question(id="boom"), question(id="big"), question(id="none")]))
+
+    answers = {"ok": GOLD, "big": qr(["a"], [["1"]], truncated=True), "none": qr(["a"], [])}
+    calls = iter(["ok", "boom", "big", "none"])
+
+    def rq(db, sql, n):
+        key = next(calls)
+        if key == "boom":
+            raise RuntimeError("relation does not exist")
+        return answers[key]
+
+    check = ev.check_gold(qs, rq)
+    assert set(check.results) == {"ok", "none"}
+    assert "relation does not exist" in check.errors["boom"]
+    assert "more than" in check.errors["big"]
+    assert check.empty == ["none"]
+
+
+def test_bad_gold_stops_the_run_before_any_model_call(tmp_path):
+    def answer(*a, **k):
+        pytest.fail("the model must not be called when gold is broken")
+
+    def broken(db, sql, n):
+        raise RuntimeError("nope")
+
+    with pytest.raises(ev.GoldError, match="aw-001"):
+        run(tmp_path, answer, run_query=broken)
+
+
+def test_skip_bad_gold_drops_only_those_questions(tmp_path):
+    rows = [question(id="good"), question(id="bad", gold_sql="SELECT 1 FROM missing")]
+
+    def run_query(db, sql, n):
+        if "missing" in sql:
+            raise RuntimeError("no such table")
+        return GOLD
+
+    report, out = run(tmp_path, lambda req, **k: graph_response(), rows=rows, skip_bad_gold=True, run_query=run_query)
+    assert [r["question_id"] for r in read(out)] == ["good"]
+    assert list(report.skipped_bad_gold) == ["bad"]
+
+
+# ----------------------------------------------------------------- scoring
+
+
+def test_correct_graph_answer_row(tmp_path):
+    report, out = run(tmp_path, lambda req, **k: graph_response())
+    (row,) = read(out)
+    assert report.written == 1
+    assert row["correct"] is True and row["status"] == "success" and row["mode"] == "graph"
+    assert row["gold_tables"] == ["person.person", "sales.customer", "sales.salesorderheader"]
+    assert row["context_tables"] == row["gold_tables"]
+    assert row["schema_recall"] == 1.0
+    assert row["bridge_tables_needed"] == ["sales.customer"]
+    assert row["bridge_tables_recovered"] == ["sales.customer"]
+    assert (row["plan_status"], row["input_tokens"], row["latency_ms"], row["attempt_count"]) == ("full", 1800, 900, 1)
+    assert (row["llm_model"], row["run_id"], row["tier"]) == ("m", "run-a", 3)
+
+
+def test_wrong_rows_and_failed_statuses_are_incorrect(tmp_path):
+    wrong = qr(["firstname", "total"], [["Jon", "1.00"]])
+    _, out = run(tmp_path, lambda req, **k: graph_response(result=wrong))
+    assert read(out)[0]["correct"] is False
+    for status in ("invalid_sql", "execution_error", "unsafe_sql", "no_schema"):
+        out.unlink()
+        _, out = run(tmp_path, lambda req, s=status, **k: graph_response(status=s, result=None))
+        assert read(out)[0]["correct"] is False and read(out)[0]["status"] == status
+
+
+def test_status_success_without_result_is_incorrect(tmp_path):
+    _, out = run(tmp_path, lambda req, **k: graph_response(result=None))
+    assert read(out)[0]["correct"] is False
+
+
+def test_missing_bridge_is_not_recovered(tmp_path):
+    resp = graph_response(tables=(HEADER, PERSON), seeds=(HEADER, PERSON), plan_status="partial")
+    _, out = run(tmp_path, lambda req, **k: resp)
+    row = read(out)[0]
+    assert row["bridge_tables_needed"] == ["sales.customer"]
+    assert row["bridge_tables_recovered"] == []
+    assert row["schema_recall"] == pytest.approx(2 / 3)
+    assert row["plan_status"] == "partial"
+
+
+def test_retrieval_mode_uses_explanation_tables_and_cannot_recover_bridges(tmp_path):
+    resp = AskResponse(
+        request_id="r", question="q", db_id=DB, mode="retrieval", status="success", sql="SELECT", result=GOLD,
+        explanation=Explanation(summary="", tables=[
+            ExplainTable(uid=HEADER, display_name="sales.salesorderheader", role="context", reason=""),
+            ExplainTable(uid=PERSON, display_name="person.person", role="context", reason="")]),
+    )
+    _, out = run(tmp_path, lambda req, **k: resp, modes=("retrieval",))
+    row = read(out)[0]
+    assert row["context_tables"] == ["person.person", "sales.salesorderheader"]
+    assert row["bridge_tables_needed"] == ["sales.customer"]   # seeds are the context, so the bridge was never offered
+    assert row["bridge_tables_recovered"] == []
+    assert row["plan_status"] is None
+
+
+def test_full_mode_leaves_bridge_metrics_empty(tmp_path):
+    resp = AskResponse(request_id="r", question="q", db_id=DB, mode="full", status="success", sql="SELECT", result=GOLD)
+    _, out = run(tmp_path, lambda req, **k: resp, modes=("full",))
+    row = read(out)[0]
+    assert row["context_tables"] == [] and row["bridge_tables_needed"] == [] and row["bridge_tables_recovered"] == []
+
+
+def test_order_matters_is_passed_to_the_comparison(tmp_path):
+    reordered = qr(["firstname", "total"], [["Eugene", "6383.66"], ["Jon", "8248.99"]])
+    _, out = run(tmp_path, lambda req, **k: graph_response(result=reordered))
+    assert read(out)[0]["correct"] is True
+    out.unlink()
+    _, out = run(tmp_path, lambda req, **k: graph_response(result=reordered), rows=[question(order_matters=True)])
+    assert read(out)[0]["correct"] is False
+
+
+# ----------------------------------------------------------------- request building
+
+
+def test_request_shape_and_flags(tmp_path):
+    seen = []
+
+    def answer(request, **kwargs):
+        seen.append((request, kwargs))
+        return graph_response(mode=request.mode)
+
+    run(tmp_path, answer, rows=[question(evidence="firstname is the given name")], modes=("full", "graph"),
+        planner_options={"weighted": False})
+    (r1, k1), (r2, k2) = seen
+    assert (r1.mode, r2.mode) == ("full", "graph")
+    assert r1.options.row_limit == ev.GOLD_ROW_LIMIT
+    assert r1.question == "total per person\nHint: firstname is the given name"
+    assert k1 == {"explain": False, "planner_options": {"weighted": False}}
+
+
+def test_evidence_can_be_left_out_and_planner_options_omitted_when_empty(tmp_path):
+    seen = []
+
+    def answer(request, **kwargs):
+        seen.append((request, kwargs))
+        return graph_response()
+
+    run(tmp_path, answer, rows=[question(evidence="hint")], use_evidence=False)
+    assert seen[0][0].question == "total per person" and seen[0][1] == {"explain": False}
+
+
+def test_unknown_mode_is_rejected(tmp_path):
+    with pytest.raises(ValueError, match="unknown mode"):
+        run(tmp_path, lambda req, **k: graph_response(), modes=("bogus",))
+
+
+# ----------------------------------------------------------------- resume and errors
+
+
+def test_resume_skips_finished_rows_and_retries_errors(tmp_path):
+    rows = [question(id="a"), question(id="b")]
+    calls = []
+
+    def flaky(request, **k):
+        calls.append(request.question)
+        if len(calls) == 2:
+            raise RuntimeError("503 from the model")
+        return graph_response()
+
+    report, out = run(tmp_path, flaky, rows=rows)
+    assert report.written == 1 and [e[:2] for e in report.errors] == [("b", "graph")]
+    assert [r["question_id"] for r in read(out)] == ["a"]
+
+    calls.clear()
+    report2, out = run(tmp_path, lambda req, **k: graph_response(), rows=rows)
+    assert report2.already_done == 1 and report2.written == 1 and not report2.errors
+    assert [r["question_id"] for r in read(out)] == ["a", "b"]
+
+
+def test_other_run_ids_are_not_resumed(tmp_path):
+    qfile = write_questions(tmp_path / "q.jsonl", [question()])
+    out = tmp_path / "r.jsonl"
+    for run_id in ("one", "two"):
+        ev.run_eval([qfile], ["graph"], out, run_id, answer=lambda req, **k: graph_response(),
+                    run_query=lambda d, s, n: GOLD, now=lambda: NOW)
+    assert [r["run_id"] for r in read(out)] == ["one", "two"]
+
+
+# ----------------------------------------------------------------- summary
+
+
+def _results(tmp_path):
+    rows = [question(id=f"q{i}", tier=1 + i % 2) for i in range(4)]
+    wrong = qr(["firstname", "total"], [["x", "1"]])
+    flip = iter([GOLD, wrong, GOLD, GOLD])
+    _, out = run(tmp_path, lambda req, **k: graph_response(result=next(flip)), rows=rows)
+    return out
+
+
+def test_aggregate_by_mode_and_tier(tmp_path):
+    rows = {(r["mode"], r["tier"]): r for r in ev.aggregate(ev.load_results(_results(tmp_path)))}
+    assert set(rows) == {("graph", "1"), ("graph", "2"), ("graph", "all")}
+    assert rows[("graph", "all")]["n"] == 4 and rows[("graph", "all")]["accuracy"] == 0.75
+    assert rows[("graph", "2")]["accuracy"] == 0.5          # q1 is wrong
+    assert rows[("graph", "all")]["bridge_recovery"] == 1.0 and rows[("graph", "all")]["bridge_needed"] == 4
+    assert rows[("graph", "all")]["input_tokens"] == 1800
+
+
+def test_summarize_dataframe_and_text(tmp_path):
+    pd = pytest.importorskip("pandas")
+    out = _results(tmp_path)
+    df = ev.summarize(out)
+    assert isinstance(df, pd.DataFrame) and list(df["tier"]) == ["1", "2", "all"]
+    text = ev.format_summary(ev.aggregate(ev.load_results(out)))
+    assert "graph" in text and "75%" in text
+
+
+def test_summary_of_empty_results_is_empty(tmp_path):
+    p = tmp_path / "e.jsonl"
+    p.write_text("")
+    assert ev.aggregate(ev.load_results(p)) == []
+
+
+def test_a_matching_result_does_not_rescue_a_failed_status(tmp_path):
+    # defensive: only status "success" counts, even if a result happens to be attached
+    _, out = run(tmp_path, lambda req, **k: graph_response(status="execution_error", result=GOLD))
+    assert read(out)[0]["correct"] is False
+
+
+# ----------------------------------------------------------------- command line
+
+
+def test_cli_summarize_and_check_gold(tmp_path, monkeypatch, capsys):
+    out = _results(tmp_path)
+    assert ev.main(["--summarize", str(out)]) == 0
+    assert "graph" in capsys.readouterr().out
+
+    qfile = write_questions(tmp_path / "cli.jsonl", [question(), question(id="aw-002")])
+    monkeypatch.setattr(ev, "_default_query", lambda db, sql, n: GOLD)
+    assert ev.main(["--questions", str(qfile), "--check-gold"]) == 0
+    assert "2 of 2 gold queries usable" in capsys.readouterr().out
+
+    def broken(db, sql, n):
+        raise RuntimeError("nope")
+
+    monkeypatch.setattr(ev, "_default_query", broken)
+    assert ev.main(["--questions", str(qfile), "--check-gold"]) == 1
+    assert "ERROR aw-001" in capsys.readouterr().out
